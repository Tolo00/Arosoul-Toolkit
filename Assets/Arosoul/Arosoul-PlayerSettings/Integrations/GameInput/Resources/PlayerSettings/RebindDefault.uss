/* Default style for the keybind sections. Added on top of PlayerSettingsDefault.uss. */

.rebind-section { margin-bottom: 12px; }

.rebind-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    margin: 8px 8px 6px 8px;
}

.rebind-row {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 4px 8px;
    margin-bottom: 2px;
    border-radius: 6px;
}

.rebind-label { width: 40%; color: rgb(225, 226, 232); font-size: 16px; }

.rebind-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px 0 0;
    padding: 6px 12px;
    border-width: 2px; 
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
}
.rebind-button:enabled:hover { background-color: rgba(255, 255, 255, 0.2); }
.rebind-button-listening { background-color: rgb(77, 124, 255); }

.settings-nav-active .rebind-button:focus, .settings-nav-active .rebind-reset:focus { border-color: white; }

.rebind-reset {
    margin: 0 0 0 8px;
    padding: 6px 12px;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(190, 192, 200);
}
.rebind-reset:enabled:hover { background-color: rgba(255, 255, 255, 0.16); }
.rebind-reset:disabled { opacity: 0.35; }
.rebind-bindings { flex-grow: 1; flex-direction: row; }
